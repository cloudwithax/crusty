# =============================================================================
# crusty environment configuration
# copy this file to .env and uncomment/edit values as needed
# =============================================================================

# -----------------------------------------------------------------------------
# required
# -----------------------------------------------------------------------------

OPENAI_API_KEY=your-api-key-here
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# -----------------------------------------------------------------------------
# api configuration
# -----------------------------------------------------------------------------

# base url for openai-compatible api (optional, defaults to openai)
# OPENAI_BASE_URL=https://api.openai.com/v1

# model to use for chat completions
# OPENAI_MODEL=gpt-4o

# rate limit for inference api calls per minute
# INFERENCE_RPM_LIMIT=40

# model to use for summarization tasks (context compression, planning)
# SUMMARIZE_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# browser configuration (agent-browser)
# -----------------------------------------------------------------------------

# agent-browser daemon starts automatically on first use - no configuration needed
# install with: npm install -g agent-browser

# -----------------------------------------------------------------------------
# context management
# -----------------------------------------------------------------------------

# maximum tokens allowed in context window
# MAX_CONTEXT_TOKENS=24000
# model to use for chat completions
# OPENAI_MODEL=gpt-4o

# rate limit for inference api calls per minute
# INFERENCE_RPM_LIMIT=40

# model to use for summarization tasks (context compression, planning)
# SUMMARIZE_MODEL=gpt-4o-mini

# tokens reserved for model response
# RESERVED_COMPLETION_TOKENS=4000

# maximum conversation turns to keep in context
# MAX_TURNS=40

# -----------------------------------------------------------------------------
# bootstrap system
# -----------------------------------------------------------------------------

# maximum characters per bootstrap file (personality, identity, etc)
# AGENTS_BOOTSTRAP_MAX_CHARS=20000

# enable soul-evil personality swap during configured time window
# AGENTS_SOUL_EVIL_ENABLED=false

# probability of soul-evil activation when in window (0.0 to 1.0)
# AGENTS_SOUL_EVIL_CHANCE=0.15

# time window for soul-evil activation (HH:MM format, 24hr)
# AGENTS_SOUL_EVIL_WINDOW_START=00:00
# AGENTS_SOUL_EVIL_WINDOW_END=06:00

# timezone for soul-evil window
# AGENTS_SOUL_EVIL_TIMEZONE=America/New_York

# -----------------------------------------------------------------------------
# heartbeat scheduler
# -----------------------------------------------------------------------------

# heartbeat interval (e.g., 30m, 1h, 2d)
# HEARTBEAT_EVERY=30m

# maximum characters in heartbeat acknowledgment
# HEARTBEAT_MAX_ACK_CHARS=500

# timezone for heartbeat active hours
# HEARTBEAT_TIMEZONE=America/New_York

# active days (1=mon, 7=sun, comma-separated)
# HEARTBEAT_DAYS=1,2,3,4,5

# active hours start time (HH:MM format, 24hr)
# HEARTBEAT_START=09:00

# active hours end time (HH:MM format, 24hr)
# HEARTBEAT_END=18:00

# -----------------------------------------------------------------------------
# embeddings (memory search)
# -----------------------------------------------------------------------------

# embedding provider: local or none
# local uses transformers.js with cpu inference, no api key needed
# EMBEDDING_PROVIDER=local

# local embedding model (huggingface model id)
# EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# local embedding vector dimension
# LOCAL_EMBEDDING_DIMENSION=384

# -----------------------------------------------------------------------------
# database
# -----------------------------------------------------------------------------

# postgres connection url (optional, defaults to sqlite)
# required for pgvector embedding search
# DATABASE_URL=postgres://user:password@localhost:5432/crusty

# -----------------------------------------------------------------------------
# shell access (linux only)
# -----------------------------------------------------------------------------

# enable local shell access outside of docker
# CRUSTY_LOCAL_SHELL=true

# custom shell path (defaults to sh, bash, or zsh if available)
# CRUSTY_SHELL=/bin/bash

# set to true when running in docker container
# CRUSTY_DOCKER=false

# -----------------------------------------------------------------------------
# debug
# -----------------------------------------------------------------------------

# NODE_ENV=development
