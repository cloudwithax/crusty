{
  "name": "crusty",
  "version": "1.0.0",
  "description": "a crab-themed telegram ai agent with web browsing capabilities",
  "module": "index.ts",
  "type": "module",
  "bin": {
    "crusty": "./cli/index.ts"
  },
  "scripts": {
    "setup": "bun cli/setup.ts",
    "start": "bun index.ts",
    "build": "bun build ./index.ts --outdir ./dist --target bun --minify --sourcemap --packages external"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/uuid": "^11.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "openai": "^6.17.0",
    "postgres": "^3.4.8",
    "sqlite-vec": "^0.1.7-alpha.2",
    "tiktoken": "^1.0.22",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  }
}